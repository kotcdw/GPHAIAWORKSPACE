# GPHA Audit Workspace - example environment file.
# Copy to `.env` and adjust for your environment.

# "development" (default) or "production". In production the app refuses to
# start while any insecure default below is still in place.
GPHA_ENVIRONMENT=development

# Change this to a long random value in production (32+ characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GPHA_SECRET_KEY=dev-secret-change-me

# Key that encrypts backups and stored working papers. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT SAFE: encrypted files cannot be recovered without it. If unset, a key
# is derived from GPHA_SECRET_KEY (changing the secret then breaks old files).
# GPHA_ENCRYPTION_KEY=

# Database: MySQL via Docker (recommended, matches docker-compose.yml).
# Start it with:  docker compose up -d
# Set the same DSN in GPHA_DATABASE_URL, or omit it and the MySQL_* vars below
# will be composed for you:
#   mysql+pymysql://gpha:gpha_dev_pass@127.0.0.1:3307/gpha_workspace?charset=utf8mb4
GPHA_DATABASE_URL=mysql+pymysql://gpha:gpha_dev_pass@127.0.0.1:3307/gpha_workspace?charset=utf8mb4

# Fallback: compose the DSN from these if GPHA_DATABASE_URL is unset.
# (3307 is used because a local XAMPP MySQL owns 3306.)
# GPHA_MYSQL_HOST=127.0.0.1
# GPHA_MYSQL_PORT=3307
# GPHA_MYSQL_USER=gpha
# GPHA_MYSQL_PASSWORD=gpha_dev_pass
# GPHA_MYSQL_DATABASE=gpha_workspace

# SQLite (ad-hoc override only). Leave GPHA_DATABASE_URL unset to use MySQL
# defaults above, or point here to bypass MySQL entirely.
# GPHA_DATABASE_URL=sqlite:///./gpha_audit_workspace.db

# Where working papers are stored (encrypted at rest).
# GPHA_UPLOAD_DIR=./uploads
# GPHA_MAX_UPLOAD_MB=25
# Comma-separated allow-list of working-paper file extensions.
# GPHA_UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.txt,.png,.jpg

# Sign-in lockout after repeated failures.
# GPHA_LOGIN_MAX_ATTEMPTS=5
# GPHA_LOGIN_LOCKOUT_MINUTES=15

# Session lifetime in hours.
GPHA_SESSION_TTL_HOURS=12

# Set to true once the app is served over HTTPS.
GPHA_COOKIE_SECURE=false

# Bootstrap administrator created by `uv run python -m scripts.init_db`.
# Change the password before first use; production refuses the default.
GPHA_ADMIN_USERNAME=admin
GPHA_ADMIN_PASSWORD=Admin@12345
GPHA_ADMIN_EMAIL=admin@gpha.local
GPHA_ADMIN_FULL_NAME=GPHA Administrator

# Automated database backups.
# Snapshots are encrypted (*.enc). Keep them outside the app folder in production.
# GPHA_BACKUP_DIR=./backups
# GPHA_BACKUP_RETENTION=7
# Scheduled interval in hours; set to 0 to disable the scheduler.
# GPHA_BACKUP_INTERVAL_HOURS=24

# --- Notifications (optional e-mail; the in-app bell always works) -----------
# GPHA_SMTP_HOST=smtp.gpha.local
# GPHA_SMTP_PORT=25
# GPHA_SMTP_USER=
# GPHA_SMTP_PASSWORD=
# GPHA_SMTP_FROM=internal.audit@gpha.gov.gh
# GPHA_SMTP_STARTTLS=false
# GPHA_APP_BASE_URL=http://127.0.0.1:8001

# --- Follow-up escalation -----------------------------------------------------
# GPHA_ESCALATE_MANAGER_DAYS=14
# GPHA_ESCALATE_CAE_DAYS=30
# GPHA_ESCALATION_CHECK_MINUTES=60

# --- Sign-in security ---------------------------------------------------------
# GPHA_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Make two-step verification mandatory for these roles (comma separated):
# GPHA_MFA_REQUIRED_ROLES=Admin,Auditor

# --- Audit closure gates (also on the Configuration screen) ------------------
# GPHA_REQUIRE_REPORT_TO_CLOSE=true
# GPHA_REQUIRE_FINDINGS_ACTIONED_TO_CLOSE=true

# --- Active Directory / LDAP sign-in (optional) --------------------------------
# When set, staff sign in with their GPHA network password. The bootstrap admin
# (GPHA_ADMIN_USERNAME) keeps its local password as a break-glass account.
# The first directory sign-in creates a pending Auditee account for an Admin to approve.
# GPHA_LDAP_URL=ldaps://dc01.gpha.local:636
# GPHA_LDAP_BIND_TEMPLATE={username}@gpha.gov.gh
# GPHA_LDAP_BASE_DN=DC=gpha,DC=local
# GPHA_LDAP_AUTO_CREATE=true

# --- E-mail through GPHA Exchange / Microsoft 365 ------------------------------
# On-premises Exchange relay (IP-allow-listed connector):
# GPHA_SMTP_HOST=mail.gpha.gov.gh
# GPHA_SMTP_PORT=25
# Microsoft 365 authenticated submission:
# GPHA_SMTP_HOST=smtp.office365.com
# GPHA_SMTP_PORT=587
# GPHA_SMTP_STARTTLS=true
# GPHA_SMTP_USER=internal.audit@gpha.gov.gh
# GPHA_SMTP_PASSWORD=
# GPHA_SMTP_FROM=internal.audit@gpha.gov.gh

# AI Service (optional, off by default). Turn it on under Configuration > AI; the key stays here, never in the database.
# For a local model (Ollama / LM Studio) no key is needed.
GPHA_AI_API_KEY=
