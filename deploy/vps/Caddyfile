# HTTPS front door for GIAW. Caddy gets and renews the certificate automatically
# (the domain's A records must point at this server first).
{
	email {$GIAW_ACME_EMAIL}
}

{$GIAW_DOMAIN}, www.{$GIAW_DOMAIN} {
	encode gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy app:8001
	header {
		-Server
	}
}
